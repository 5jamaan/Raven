{
  "filters": {
    "and": [
      "!file.inFolder(\"00-System\")",
      "type == \"task\"",
      "status != \"done\"",
      "due && date(due) < today() + \"1d\""
    ]
  },
  "properties": {
    "file.name": {
      "displayName": "Kayıt"
    },
    "note.next_action": {
      "displayName": "Sonraki adım"
    },
    "note.review_date": {
      "displayName": "Gözden geçirme"
    },
    "note.status": {
      "displayName": "Durum"
    },
    "note.due": {
      "displayName": "Tarih"
    }
  },
  "views": [
    {
      "type": "table",
      "name": "Bugün ve gecikenler",
      "order": [
        "file.name",
        "due",
        "status"
      ]
    }
  ]
}