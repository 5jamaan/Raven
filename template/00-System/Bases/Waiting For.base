{
  "filters": {
    "and": [
      "!file.inFolder(\"00-System\")",
      "status == \"waiting\""
    ]
  },
  "properties": {
    "file.name": {
      "displayName": "Kayıt"
    },
    "note.next_action": {
      "displayName": "Sonraki adım"
    },
    "note.review_date": {
      "displayName": "Gözden geçirme"
    },
    "note.status": {
      "displayName": "Durum"
    },
    "note.due": {
      "displayName": "Tarih"
    }
  },
  "views": [
    {
      "type": "table",
      "name": "Beklenen yanıtlar",
      "order": [
        "file.name",
        "review_date"
      ]
    }
  ]
}
